# Copy to .env and fill in. Never commit .env.

# ── Runtime ──────────────────────────────────────────────────────────────
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# ── Database ─────────────────────────────────────────────────────────────
# Local dev/test use the compose Postgres on 5433 (5432 is often taken by a
# native install). In the compose "prod" profile the API is given its own
# DATABASE_URL pointing at the postgres service; this value is for local runs.
DATABASE_URL=postgres://ams:ams@localhost:5433/ams
DATABASE_URL_TEST=postgres://ams:ams@localhost:5433/ams_test
# Server-side statement timeout as a startup parameter. 0 = omit (required
# behind a transaction-mode pooler such as Neon or Supabase pooled URLs).
DB_STATEMENT_TIMEOUT_MS=5000
POSTGRES_PASSWORD=ams

# ── Ingest ───────────────────────────────────────────────────────────────
# Secret path segment: the webhook URL becomes https://<host>/ingest/<token>/raw
# Generate with:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
INGEST_PATH_TOKEN=
# Body cap in bytes (spec: 1 MB)
INGEST_BODY_LIMIT_BYTES=1048576
# Addresses allowed to post scans, comma-separated IPs or CIDR blocks.
# Empty allows all — fill this in once the discovery report shows which
# addresses the platform posts from.
INGEST_ALLOWED_IPS=
# Requests per address per minute. Must be generous: the platform never
# retries, so a refused scan is lost forever. 0 disables it.
INGEST_RATE_LIMIT_PER_MINUTE=1000
SPOOL_DIR=./data/spool
SPOOL_DRAIN_INTERVAL_MS=60000
# How often outstanding envelopes are processed on a long-running deployment.
# Ingest already triggers processing immediately; this is the safety net.
PROCESS_INTERVAL_MS=15000
# Token for the scheduled processing endpoint. Vercel sets this itself when a
# cron job is configured; falls back to REPORT_TOKEN when unset.
CRON_SECRET=

# ── Report ───────────────────────────────────────────────────────────────
# Static token for GET /ingest/report (>= 32 chars). Generate as above.
REPORT_TOKEN=

# ── Reverse proxy ────────────────────────────────────────────────────────
# true only when Caddy (or another proxy) sits in front and sets X-Forwarded-For.
TRUST_PROXY=false
# Public hostname Caddy should obtain a certificate for (prod profile only).
PUBLIC_HOST=ams.example.com

# ── Backups ──────────────────────────────────────────────────────────────
# Long and random, and stored somewhere OTHER than this server. A backup
# encrypted with a key kept beside it protects against nothing.
BACKUP_PASSPHRASE=
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
