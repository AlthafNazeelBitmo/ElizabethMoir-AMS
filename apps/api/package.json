{
  "name": "@ams/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude \"**/*.load.test.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "test:watch": "vitest",
    "create-user": "tsx src/cli/create-user.ts",
    "import-directory": "tsx src/cli/import-directory.ts",
    "demo": "tsx src/cli/demo-server.ts",
    "test:load": "vitest run load.load.test --no-file-parallelism"
  },
  "dependencies": {
    "@ams/shared": "workspace:*",
    "@fastify/cookie": "^11",
    "@fastify/helmet": "^13",
    "@fastify/multipart": "^9",
    "@node-rs/argon2": "^2.2.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.5",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.20.3",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "vitest": "^5.0.1"
  }
}
