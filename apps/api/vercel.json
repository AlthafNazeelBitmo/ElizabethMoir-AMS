{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "pnpm run build:vercel",
  "outputDirectory": ".static",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/ingest/:path*",
      "destination": "/api"
    },
    {
      "source": "/internal/:path*",
      "destination": "/api"
    },
    {
      "source": "/healthz",
      "destination": "/api"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 15,
      "memory": 512
    }
  },
  "crons": [
    {
      "path": "/internal/process",
      "schedule": "0 4 * * *"
    }
  ]
}
